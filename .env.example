# Copy to .env and fill in. Never commit .env.

# Public HTTPS address as served by your reverse proxy (no trailing slash).
# Must match exactly – passkeys are bound to this domain.
PUBLIC_URL=https://woerter.example.de

# Long random values, e.g.: openssl rand -base64 48
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=   # letters/digits only (openssl rand -hex 32), it ends up in a URL

# Optional: fixed one-time token for the setup wizard. If empty, a token is
# generated on first visit to /einrichtung and printed in `docker compose logs app`.
SETUP_TOKEN=

# Optional: API key for an OpenAI-compatible AI provider (configured in Verwaltung → KI).
AI_API_KEY=

# Host port and bind address. 127.0.0.1 = only reachable by a proxy on the host;
# 0.0.0.0 = reachable from the network (e.g. proxy on another machine).
APP_PORT=3000
APP_BIND=127.0.0.1
